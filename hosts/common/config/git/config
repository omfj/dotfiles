[user]
	name = Ole Magnus Fon Johnsen
	email = me@omfj.no
	signingkey = A20C43840D841F41
[commit]
	gpgsign = true
[gpg]
	program = gpg2
[pull]
	rebase = true
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
	excludesfile = /Users/olem/.gitignore_global
[alias]
	ac = commit -S -am
	s = status
	st = status
	cm = "!f() { git commit -m \"$*\"; }; f"
	c = clone
	lg = log --oneline --graph
	fomo = "!f() { git fetch origin ${1:-main} && git rebase origin/${1:-main}; }; f"
	cleanup-branches = "!git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -d"
	yolo = push -f
	fl = push --force-with-lease
	ai = "!convmit --edit"
	rc = rebase --continue
	pb = "!git switch $(git branch | grep -v HEAD | fzf | tr -d ' ')"

	# worktrees: should live next to the main repo as; ../<repo>-wt-<branch>
	wt = worktree
	wl = worktree list
	wp = worktree prune
	wadd = "!f() { \
		b=\"$1\"; [ -z \"$b\" ] && { echo 'usage: git wa <branch> [base]'; return 1; }; \
		root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\"); \
		dir=\"$(dirname \"$root\")/$(basename \"$root\")-wt-$(echo \"$b\" | tr / -)\"; \
		if git show-ref --verify --quiet \"refs/heads/$b\"; then git worktree add \"$dir\" \"$b\"; \
		else git worktree add -b \"$b\" \"$dir\" \"${2:-HEAD}\"; fi; }; f"
	wrm = "!git worktree list | tail -n +2 | fzf | awk '{print $1}' | xargs -r git worktree remove"
	wpick = "!git worktree list | fzf --height 40% | awk '{print $1}'"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
    	line-numbers = true
[merge]
	conflictstyle = zdiff3
