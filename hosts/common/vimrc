" ~/.vimrc — plain Vim, no third-party plugins. Works on macOS, Linux and
" Windows (Vim reads ~/.vimrc there too, after ~/_vimrc), including the Vim
" that ships with Git Bash (an MSYS build: has('unix') and has('win32unix')
" are true, has('win32') is false). Targets Vim 9.1 at any patch level;
" anything added by a 9.1.x patch is guarded or has a fallback below.
" Keymaps mirror the Neovim config where sensible.
"
" Style guide:
"   - Sections start with a `" Name ----` heading padded with dashes to
"     column 80, and are separated by three blank lines.
"   - No line is longer than 80 columns.
"   - Prefer 'single quotes'; use "double quotes" only for escapes like "\e"
"     or "\<C-v>".
"   - Only use what ships with Vim 9.1.0000 (incl. $VIMRUNTIME/pack/dist/opt);
"     guard anything from a later 9.1.x patch with has() or exists().
"     Besides Vim, ripgrep (rg), fzf, bat and git may be assumed. No
"     third-party plugins.
"   - Never put a trailing "comment after a mapping; it becomes part of it.
"   - Don't rely on trailing whitespace (it is stripped on save); set such
"     options with `let &option = '...'` instead.

set nocompatible
set encoding=utf-8
scriptencoding utf-8
filetype plugin indent on
syntax enable



" Built-in optional packages ---------------------------------------------------
silent! packadd! matchit       " better % on if/else, tags, etc.
silent! packadd! editorconfig  " respect .editorconfig
silent! packadd! cfilter       " :Cfilter /pat/ to filter quickfix

" The comment and hlyank packages only ship with later 9.1 patches;
" without them the stand-ins further down are used instead
function! s:HasPack(name) abort
  return !empty(globpath(&packpath, 'pack/*/opt/' . a:name))
endfunction
let s:has_comment = s:HasPack('comment')
let s:has_hlyank = s:HasPack('hlyank')
if s:has_comment
  packadd! comment
endif
if s:has_hlyank
  packadd! hlyank
endif



" General ----------------------------------------------------------------------
set fileformats=unix,dos       " prefer LF for new files, also on Windows
set hidden                    " switch buffers without saving
set autoread autowrite
set confirm                    " ask instead of failing on :q with changes
set backspace=indent,eol,start
set mouse=a
if exists('&ttymouse') && !has('gui_running')
  set ttymouse=sgr
endif
set updatetime=200
" Wait indefinitely for the rest of a mapping (like mini.clue in Neovim);
" key codes such as <Esc> and arrows still time out quickly
set notimeout ttimeout ttimeoutlen=10
set history=1000
set nrformats-=octal
set virtualedit=block
set belloff=all
set shortmess+=IcC

" Add Norwegian to spell checking only if its spellfile is installed
" (otherwise Vim prompts to download it every time spell is enabled)
let g:spelllangs = empty(globpath(&runtimepath, 'spell/nb.*.spl'))
      \ ? 'en' : 'en,nb'

" '+' only differs from '*' on X11/Wayland; elsewhere 'unnamed' is enough
if has('unnamedplus')
  set clipboard^=unnamed,unnamedplus
elseif has('clipboard')
  set clipboard^=unnamed
endif

" Git Bash's Vim has no clipboard support, but MSYS exposes the Windows
" clipboard as /dev/clipboard: copy unnamed yanks there, paste with
" :r /dev/clipboard
let s:devclip = !has('clipboard') && has('win32unix')
      \ && filewritable('/dev/clipboard')
function! s:SetClipboard(lines, linewise) abort
  if s:devclip
    call writefile(a:lines + (a:linewise ? [''] : []), '/dev/clipboard', 'b')
  else
    call setreg('+', a:lines, a:linewise ? 'l' : 'c')
  endif
endfunction
if s:devclip
  augroup vimrc_clipboard
    autocmd!
    autocmd TextYankPost * if v:event.regname ==# ''
          \ |   call s:SetClipboard(v:event.regcontents,
          \       v:event.regtype ==# 'V')
          \ | endif
  augroup END
endif

" Keep swap/backup/undo files out of the working directory.
" First 'runtimepath' entry is ~/.vim on Unix and ~/vimfiles on Windows.
let s:vimdir = expand(split(&runtimepath, ',')[0])
for s:d in ['undo', 'swap', 'backup']
  if !isdirectory(s:vimdir . '/' . s:d)
    call mkdir(s:vimdir . '/' . s:d, 'p', 0700)
  endif
endfor
let &undodir   = s:vimdir . '/undo//'
let &directory = s:vimdir . '/swap//'
let &backupdir = s:vimdir . '/backup//'
set undofile undolevels=10000
set viminfo='1000,<100,s10,h



" UI ---------------------------------------------------------------------------
set number relativenumber
set signcolumn=yes
set cursorline
set scrolloff=5 sidescrolloff=8
set splitbelow splitright
set nowrap
set linebreak breakindent
let &showbreak = '↪ '
set display=lastline,uhex
set laststatus=2
set showcmd
set noshowmode
set wildmenu wildoptions=pum,fuzzy
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*.o,*.pyc,.DS_Store
set wildignore+=*/.git/*,*/node_modules/*,*/target/*,*/dist/*
set completeopt=menuone,noselect,popup
set pumheight=10
set listchars=tab:➙\ ,trail:␣,extends:⟩,precedes:⟨,nbsp:·
let &fillchars = 'vert:│,fold: ,eob: '
set foldmethod=syntax foldlevelstart=99

" Cursor shape: bar in insert, underline in replace, block otherwise
" (Windows console Vim and GUI Vim handle the cursor shape themselves)
if !has('gui_running') && !has('win32')
  let &t_SI = "\e[6 q"
  let &t_SR = "\e[4 q"
  let &t_EI = "\e[2 q"
endif

" True colour in truecolor terminals and in Windows Terminal / modern conhost.
" mintty (Git Bash) and Windows Terminal don't always set $COLORTERM.
if has('termguicolors') && ($COLORTERM =~# 'truecolor\|24bit' || has('vcon')
      \ || $TERM_PROGRAM ==# 'mintty' || !empty($WT_SESSION))
  set termguicolors
endif

if has('gui_running')
  set guioptions-=T guioptions-=m guioptions-=r guioptions-=L
  if has('win32')
    set guifont=Cascadia_Mono:h11,Consolas:h11
    set renderoptions=type:directx
  elseif has('mac')
    set guifont=Menlo:h13
  endif
endif
set background=dark
silent! colorscheme habamax

" Statusline
let s:modes = {'n': 'NORMAL', 'i': 'INSERT', 'R': 'REPLACE', 'v': 'VISUAL',
      \ 'V': 'V-LINE', "\<C-v>": 'V-BLOCK', 'c': 'COMMAND', 's': 'SELECT',
      \ 'S': 'S-LINE', "\<C-s>": 'S-BLOCK', 't': 'TERMINAL'}
function! StatusMode() abort
  return get(s:modes, mode(), mode())
endfunction
let &statusline = '%#PmenuSel# %{StatusMode()} %* %f%m%r%h%w%='
      \ . '%y %{&fenc!=""?&fenc:&enc} [%{&ff}] %l:%c %p%% '



" Search -----------------------------------------------------------------------
set incsearch hlsearch
set ignorecase smartcase
" Native Windows rg prints 'dir\file' paths, which Git Bash's Vim can't open
let s:rg = 'rg' . (has('win32unix') ? ' --path-separator /' : '')
if executable('rg')
  let &grepprg = s:rg . ' --vimgrep --smart-case'
  set grepformat=%f:%l:%c:%m
endif



" Indentation ------------------------------------------------------------------
set autoindent smartindent
set expandtab tabstop=4 shiftwidth=4 softtabstop=-1 shiftround
set formatoptions+=jn



" File finding -----------------------------------------------------------------
" :find searches recursively from cwd; <Tab> completes with fuzzy matching.
set path=.,**

" With ripgrep, :find/:sfind/:tabfind complete from `rg --files` (respects
" .gitignore) filtered by Vim's own fuzzy matcher. Cached per command line.
if executable('rg') && exists('+findfunc')
  let s:rg_files = []
  function! VimrcFind(arg, cmdcomplete) abort
    if empty(s:rg_files)
      let s:rg_files = systemlist(s:rg . ' --files --hidden --glob '
            \ . shellescape('!.git'))
    endif
    return empty(a:arg) ? s:rg_files : matchfuzzy(s:rg_files, a:arg)
  endfunction
  set findfunc=VimrcFind
  augroup vimrc_find
    autocmd!
    autocmd CmdlineEnter : let s:rg_files = []
  augroup END
endif



" fzf picker (no fzf.vim needed) -----------------------------------------------
" Runs the fzf binary in a popup terminal and passes the selection to a
" callback. <C-v>/<C-x>/<C-t> open in vsplit/split/tab, <Tab> multi-selects
" (several grep hits go to the quickfix list). Previews use bat if present.
let s:has_fzf = executable('fzf') && has('terminal') && has('popupwin')
let s:has_bat = executable('bat')
let s:actions = {'': 'edit', 'ctrl-v': 'vsplit', 'ctrl-x': 'split',
      \ 'ctrl-t': 'tabedit'}

" Quote one argument for the script the picker writes (sh or cmd.exe)
function! s:Quote(s) abort
  if has('win32')
    let s = substitute(a:s, '"', '\\"', 'g')
    return '"' . substitute(s, '%', '%%', 'g') . '"'
  endif
  return "'" . substitute(a:s, "'", "'\\\\''", 'g') . "'"
endfunction

" source: shell command that prints lines, a List of lines, or '' (fzf's own
" default). args: List of extra fzf arguments. Sink gets (action, lines).
function! s:Fzf(source, args, Sink) abort
  let s:fzf = {'sink': a:Sink, 'out': tempname(), 'tmp': []}
  let expect = filter(keys(s:actions), 'v:val !=# ""')
  let args = ['--layout=reverse', '--info=inline', '--multi',
        \ '--expect=' . join(expect, ',')] + a:args
  let cmd = 'fzf ' . join(map(args, 's:Quote(v:val)'))
  if type(a:source) == v:t_list
    let in = tempname()
    call writefile(a:source, in)
    call add(s:fzf.tmp, in)
    let cmd .= ' < ' . s:Quote(in)
  elseif !empty(a:source)
    let cmd = a:source . ' | ' . cmd
  endif
  let cmd .= ' > ' . s:Quote(s:fzf.out)

  " Run through a script file so quoting/redirection behave the same everywhere
  let script = tempname() . (has('win32') ? '.bat' : '.sh')
  call add(s:fzf.tmp, script)
  call writefile(has('win32')
        \ ? ['@echo off', 'chcp 65001 >nul', cmd] : [cmd], script)
  let job = has('win32') ? ['cmd.exe', '/c', script] : ['sh', script]

  let w = max([40, float2nr(&columns * 0.9)])
  let h = max([10, float2nr(&lines * 0.8)])
  let buf = term_start(job, {'hidden': 1, 'term_finish': 'close',
        \ 'term_cols': w, 'term_rows': h,
        \ 'exit_cb': {j, st -> timer_start(10, {-> s:FzfDone(st)})}})
  let s:fzf.buf = buf
  let win = popup_create(buf, {'minwidth': w, 'minheight': h, 'border': [],
        \ 'borderchars': ['─', '│', '─', '│', '╭', '╮', '╯', '╰']})
  " <Esc> goes straight to fzf instead of waiting for the global <Esc><Esc>
  call win_execute(win, 'tnoremap <buffer> <nowait> <Esc> <Esc>')
endfunction

function! s:FzfDone(status) abort
  " term_finish 'close' only closes the window; wipe the finished buffer too
  if has_key(s:fzf, 'buf') && bufexists(s:fzf.buf)
    execute 'silent! bwipeout!' s:fzf.buf
  endif
  let lines = filereadable(s:fzf.out) ? readfile(s:fzf.out) : []
  for f in s:fzf.tmp + [s:fzf.out]
    call delete(f)
  endfor
  if a:status == 0 && len(lines) > 1
    call s:fzf.sink(get(s:actions, lines[0], 'edit'), lines[1:])
  endif
endfunction

function! s:OpenFiles(cmd, files) abort
  for f in a:files
    execute a:cmd fnameescape(f)
  endfor
endfunction

function! s:OpenGrep(cmd, lines) abort
  if len(a:lines) > 1
    call setqflist([], ' ',
          \ {'lines': a:lines, 'efm': '%f:%l:%c:%m', 'title': 'Grep'})
    copen | cfirst
    return
  endif
  let [file, lnum, col] = matchlist(a:lines[0], '\v^(.{-}):(\d+):(\d+):')[1:3]
  execute a:cmd fnameescape(file)
  call cursor(str2nr(lnum), str2nr(col))
  normal! zvzz
endfunction

function! s:FilePreview() abort
  return s:has_bat ? ['--preview',
        \ 'bat --color=always --style=numbers --line-range=:300 {}'] : []
endfunction

function! s:Files() abort
  if !s:has_fzf | call feedkeys(':find ', 'n') | return | endif
  let src = executable('rg')
        \ ? s:rg . ' --files --hidden --glob ' . s:Quote('!.git') : ''
  call s:Fzf(src, ['--prompt', 'Files> '] + s:FilePreview(),
        \ function('s:OpenFiles'))
endfunction

function! s:Buffers() abort
  if !s:has_fzf | call feedkeys(':buffer ', 'n') | return | endif
  let bufs = filter(range(1, bufnr('$')),
        \ 'buflisted(v:val) && v:val != bufnr("%")')
  let names = map(bufs, 'empty(bufname(v:val)) ? v:val . ":[No Name]"'
        \ . ' : fnamemodify(bufname(v:val), ":~:.")')
  call s:Fzf(names, ['--prompt', 'Buffers> '] + s:FilePreview(),
        \ function('s:OpenFiles'))
endfunction

function! s:Recent() abort
  if !s:has_fzf | browse oldfiles | return | endif
  let files = filter(copy(v:oldfiles), 'filereadable(expand(v:val))')
  let files = map(files, 'fnamemodify(expand(v:val), ":~:.")')
  call s:Fzf(files, ['--prompt', 'Recent> ', '--no-sort'] + s:FilePreview(),
        \ function('s:OpenFiles'))
endfunction

" Live grep: rg re-runs on every keystroke, fzf only displays the results
function! s:Grep(query) abort
  if !s:has_fzf || !executable('rg')
    call feedkeys(':silent grep! ' . a:query, 'n') | return
  endif
  let rg = s:rg . ' --column --line-number --no-heading --color=always'
        \ . ' --smart-case -- {q} || ' . (has('win32') ? 'cd .' : 'true')
  let args = ['--prompt', 'Grep> ', '--ansi', '--disabled', '--query', a:query,
        \ '--delimiter', ':',
        \ '--bind', 'start:reload:' . rg, '--bind', 'change:reload:' . rg]
  if s:has_bat
    let args += ['--preview',
          \ 'bat --color=always --style=numbers --highlight-line {2} {1}',
          \ '--preview-window', '+{2}/2']
  endif
  call s:Fzf('', args, function('s:OpenGrep'))
endfunction

command! -nargs=0 Files call s:Files()
command! -nargs=0 Buffers call s:Buffers()
command! -nargs=0 Recent call s:Recent()
command! -nargs=* Grep call s:Grep(<q-args>)



" Commenting (stand-in for the comment package) -------------------------------
" Only used on 9.1 builds that predate the package. gc{motion}, gcc (with
" count) and visual gc toggle comments using 'commentstring'. If every
" non-blank line is commented they are uncommented.
if !s:has_comment
  function! VimrcComment(type, ...) abort
    let [l1, l2] = a:0 ? [line("'<"), line("'>")] : [line("'["), line("']")]
    let parts = split(&commentstring =~# '%s' ? &commentstring : '# %s',
          \ '%s', 1)
    let pre = substitute(parts[0], '\s*$', '', '')
    let post = substitute(get(parts, 1, ''), '^\s*', '', '')
    let rx = '\V\^\(\s\*\)' . escape(pre, '\') . ' \?\(\.\{-}\)'
          \ . (empty(post) ? '' : ' \?' . escape(post, '\')) . '\$'
    let lines = getline(l1, l2)
    let code = filter(copy(lines), {_, l -> l =~# '\S'})
    if empty(code)
      return
    endif
    if empty(filter(copy(code), {_, l -> l !~# rx}))
      call map(lines, {_, l -> l =~# rx ? substitute(l, rx, '\1\2', '') : l})
    else
      let ind = min(map(copy(code), {_, l -> match(l, '\S')}))
      call map(lines, {_, l -> l !~# '\S' ? l : strpart(l, 0, ind) . pre
            \ . ' ' . strpart(l, ind) . (empty(post) ? '' : ' ' . post)})
    endif
    call setline(l1, lines)
  endfunction

  function! s:CommentOp() abort
    set operatorfunc=VimrcComment
    return 'g@'
  endfunction
  nnoremap <expr> gc <SID>CommentOp()
  nnoremap <expr> gcc <SID>CommentOp() . '_'
  xnoremap <silent> gc :<C-u>call VimrcComment(visualmode(), 1)<CR>
endif



" Yank highlight (stand-in for the hlyank package) -----------------------------
" Only used on 9.1 builds that predate the package.
if !s:has_hlyank
  function! s:HlYank() abort
    if v:event.operator !=# 'y' || v:event.regtype =~# "^\<C-v>"
      return
    endif
    let [l1, c1, l2, c2] = [line("'["), col("'["), line("']"), col("']")]
    let pat = v:event.regtype ==# 'V'
          \ ? '\%>' . (l1 - 1) . 'l\%<' . (l2 + 1) . 'l.*'
          \ : '\%' . l1 . 'l\%' . c1 . 'c\_.\{-}\%' . l2 . 'l\%' . c2 . 'c.'
    let id = matchadd('IncSearch', pat)
    let win = win_getid()
    call timer_start(150, {-> win_getid() == win ? matchdelete(id) : 0})
  endfunction
  augroup vimrc_hlyank
    autocmd!
    autocmd TextYankPost * silent! call s:HlYank()
  augroup END
endif



" Git signs ------------------------------------------------------------------
" Marks lines added, changed or removed relative to the git index in the sign
" column (like mini.diff in Neovim). ]c / [c jump between hunks (or between
" changes in diff mode). Updates on read, write, focus and while typing.
if executable('git') && exists('*sign_place') && has('job') && has('timers')
  call sign_define('GitAdd', {'text': '▌', 'texthl': 'GitSignAdd'})
  call sign_define('GitChange', {'text': '▌', 'texthl': 'GitSignChange'})
  call sign_define('GitDelete', {'text': '▁', 'texthl': 'GitSignDelete'})

  function! s:GitSignHighlights() abort
    let groups = {'Add': ['Added', 'DiffAdd'],
          \ 'Change': ['Changed', 'DiffChange'],
          \ 'Delete': ['Removed', 'DiffDelete']}
    for [name, links] in items(groups)
      let target = hlexists(links[0]) ? links[0] : links[1]
      execute 'highlight default link GitSign' . name target
    endfor
  endfunction
  call s:GitSignHighlights()

  " Per buffer: index version (base), buffer contents (cur), debounce timer
  " and the first line of each hunk
  let s:git = {}

  " Fetch the index version of the buffer's file, then diff against it
  function! s:GitBase(buf) abort
    let file = resolve(fnamemodify(bufname(a:buf), ':p'))
    if !empty(getbufvar(a:buf, '&buftype')) || !filereadable(file)
      return s:GitForget(a:buf)
    endif
    let base = systemlist('git -C ' . shellescape(fnamemodify(file, ':h'))
          \ . ' show ' . shellescape(':./' . fnamemodify(file, ':t')))
    if v:shell_error
      return s:GitForget(a:buf)
    endif
    if !has_key(s:git, a:buf)
      let s:git[a:buf] = {'base': tempname(), 'cur': tempname(),
            \ 'timer': -1, 'hunks': []}
    endif
    call writefile(base, s:git[a:buf].base)
    call s:GitDiff(a:buf)
  endfunction

  function! s:GitForget(buf) abort
    if has_key(s:git, a:buf)
      call timer_stop(s:git[a:buf].timer)
      call delete(s:git[a:buf].base)
      call delete(s:git[a:buf].cur)
      call remove(s:git, a:buf)
    endif
    if bufexists(a:buf)
      call sign_unplace('gitsigns', {'buffer': a:buf})
    endif
  endfunction

  " Diff the buffer contents against the index version in the background
  function! s:GitDiff(buf) abort
    if !has_key(s:git, a:buf) || !bufloaded(a:buf)
      return
    endif
    let buf = a:buf
    let st = s:git[buf]
    call writefile(getbufline(buf, 1, '$'), st.cur)
    let out = []
    call job_start(['git', 'diff', '--no-index', '--no-color',
          \ '--no-ext-diff', '--ignore-cr-at-eol', '-U0', st.base, st.cur], {
          \ 'in_io': 'null', 'err_io': 'null',
          \ 'out_cb': {_, l -> add(out, l)},
          \ 'close_cb': {_ -> s:GitPlace(buf, out)}})
  endfunction

  " Turn the '@@ -old,count +new,count @@' hunk headers into signs
  function! s:GitPlace(buf, out) abort
    if !has_key(s:git, a:buf) || !bufloaded(a:buf)
      return
    endif
    call sign_unplace('gitsigns', {'buffer': a:buf})
    let hunks = []
    let rx = '^@@ -\d\+\%(,\(\d\+\)\)\? +\(\d\+\)\%(,\(\d\+\)\)\? @@'
    for l in a:out
      let m = matchlist(l, rx)
      if empty(m)
        continue
      endif
      let old = m[1] ==# '' ? 1 : str2nr(m[1])
      let start = str2nr(m[2])
      let new = m[3] ==# '' ? 1 : str2nr(m[3])
      if new == 0
        let lnums = [max([1, start])]
        let sign = 'GitDelete'
      else
        let lnums = range(start, start + new - 1)
        let sign = old == 0 ? 'GitAdd' : 'GitChange'
      endif
      call add(hunks, lnums[0])
      for lnum in lnums
        call sign_place(0, 'gitsigns', sign, a:buf,
              \ {'lnum': lnum, 'priority': 5})
      endfor
    endfor
    let s:git[a:buf].hunks = hunks
  endfunction

  function! s:GitSchedule(buf) abort
    if !has_key(s:git, a:buf)
      return
    endif
    let buf = a:buf
    call timer_stop(s:git[buf].timer)
    let s:git[buf].timer = timer_start(150, {-> s:GitDiff(buf)})
  endfunction

  function! s:GitHunk(dir) abort
    if &diff
      execute 'normal!' v:count1 . (a:dir > 0 ? ']c' : '[c')
      return
    endif
    let hunks = get(get(s:git, bufnr('%'), {}), 'hunks', [])
    let lnum = line('.')
    let targets = a:dir > 0
          \ ? filter(copy(hunks), {_, h -> h > lnum})
          \ : reverse(filter(copy(hunks), {_, h -> h < lnum}))
    if !empty(targets)
      execute 'normal!' targets[min([v:count1, len(targets)]) - 1] . 'G'
    endif
  endfunction
  nnoremap <silent> ]c :<C-u>call <SID>GitHunk(1)<CR>
  nnoremap <silent> [c :<C-u>call <SID>GitHunk(-1)<CR>

  augroup vimrc_gitsigns
    autocmd!
    autocmd BufReadPost,BufWritePost,FileChangedShellPost *
          \ call s:GitBase(str2nr(expand('<abuf>')))
    autocmd FocusGained,ShellCmdPost * call s:GitBase(bufnr('%'))
    autocmd TextChanged,TextChangedI,InsertLeave *
          \ call s:GitSchedule(bufnr('%'))
    autocmd BufWipeout * call s:GitForget(str2nr(expand('<abuf>')))
    autocmd ColorScheme * call s:GitSignHighlights()
  augroup END
endif



" netrw (built-in file explorer) -----------------------------------------------
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25
let g:netrw_list_hide = '\(^\|\s\s\)\zs\.\S\+,\.DS_Store'



" Keymaps ----------------------------------------------------------------------
" NB: never put a trailing "comment after a mapping — it becomes part of it.
let mapleader = ' '
let maplocalleader = ','

" Move by display line when no count is given
nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'

" n/N always search in the same direction, and open folds
nnoremap <expr> n 'Nn'[v:searchforward] . 'zv'
nnoremap <expr> N 'nN'[v:searchforward] . 'zv'

" Y behaves like D and C
nnoremap Y y$

" Keep selection when indenting
xnoremap < <gv
