" Copy relative path (with line range in visual mode)
function! s:CopyPath(visual) abort
  let path = expand('%:~:.')
        \ . (a:visual ? ':' . line("'<") . ':' . line("'>") : '')
  call s:SetClipboard([path], 0)
  echo 'Copied: ' . path
endfunction
nnoremap <silent> <leader>fy :call <SID>CopyPath(0)<CR>
xnoremap <silent> <leader>fy :<C-u>call <SID>CopyPath(1)<CR>

