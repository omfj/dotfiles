" ~/.vimrc — plain Vim, no third-party plugins. Works on macOS, Linux and
" Windows (Vim reads ~/.vimrc there too, after ~/_vimrc), including the Vim
" that ships with Git Bash (an MSYS build: has('unix') and has('win32unix')
" are true, has('win32') is false). Targets Vim 9.1 at any patch level;
" anything added by a 9.1.x patch is guarded or has a fallback below.
" Keymaps mirror the Neovim config where sensible. Larger features are
" plugins in ./vim/plugin (fzf pickers, git signs, ripgrep integration,
" gc commenting, completion, a which-key list, an LSP client for Rust,
" C/C++ and C#); they follow the same style guide.
"
" Style guide:
"   - Sections start with a `" Name ----` heading padded with dashes to
"     column 80, and are separated by three blank lines.
"   - No line is longer than 80 columns.
"   - Prefer 'single quotes'; use "double quotes" only for escapes like "\e"
"     or "\<C-v>".
"   - Only use what ships with Vim 9.1.0000 (incl. $VIMRUNTIME/pack/dist/opt);
"     guard anything from a later 9.1.x patch with has() or exists().
"     Besides Vim, ripgrep (rg), fzf, bat and git may be assumed. No
"     third-party plugins.
"   - Never put a trailing "comment after a mapping; it becomes part of it.
"   - Don't rely on trailing whitespace (it is stripped on save); set such
"     options with `let &option = '...'` instead.

set nocompatible
set encoding=utf-8
scriptencoding utf-8
filetype plugin indent on
syntax enable

" Set before any <leader> mapping (some are defined in sections below)
let mapleader = ' '
let maplocalleader = ','

" Custom plugins live in vim/ next to the real (symlinked) vimrc; Vim sources
" vim/plugin/*.vim right after this file. Appended, not prepended: the first
" 'runtimepath' entry is where undo/swap/backup files go (see General).
let s:plugdir = fnamemodify(resolve(expand('<sfile>:p')), ':h') . '/vim'
if isdirectory(s:plugdir)
  let &runtimepath .= ',' . s:plugdir
endif



" Built-in optional packages ---------------------------------------------------
silent! packadd! matchit       " better % on if/else, tags, etc.
silent! packadd! editorconfig  " respect .editorconfig
silent! packadd! cfilter       " :Cfilter /pat/ to filter quickfix

" Don't highlight the matching paren/bracket under the cursor
let g:loaded_matchparen = 1

" The hlyank package only ships with later 9.1 patches; without it the
" stand-in further down is used instead (gc commenting: vim/plugin/comment.vim)
let s:has_hlyank = !empty(globpath(&packpath, 'pack/*/opt/hlyank', 1))
if s:has_hlyank
  packadd! hlyank
endif



" General ----------------------------------------------------------------------
set fileformats=unix,dos       " prefer LF for new files, also on Windows
set hidden                    " switch buffers without saving
set autoread autowrite
set confirm                    " ask instead of failing on :q with changes
set backspace=indent,eol,start
set mouse=a
if exists('&ttymouse') && !has('gui_running')
  set ttymouse=sgr
endif
set updatetime=200
" Wait indefinitely for the rest of a mapping (like mini.clue in Neovim);
" key codes such as <Esc> and arrows still time out quickly
set notimeout ttimeout ttimeoutlen=10
set history=1000
set nrformats-=octal
set virtualedit=block
set belloff=all
set shortmess+=IcC
set nojoinspaces               " one space after '.' when joining lines
if exists('+jumpoptions')
  set jumpoptions=stack        " <C-o>/<C-i> work like back/forward
endif

" Set an option value that only some 9.1 patches accept (exists() can't
" test for option values); unsupported values are silently skipped
function! s:TrySet(arg) abort
  try
    execute 'set' a:arg
  catch /^Vim\%((\a\+)\)\=:E474:/
  endtry
endfunction

" Add Norwegian to spell checking only if its spellfile is installed
" (otherwise Vim prompts to download it every time spell is enabled)
let g:spelllangs = empty(globpath(&runtimepath, 'spell/nb.*.spl'))
      \ ? 'en' : 'en,nb'

" '+' only differs from '*' on X11/Wayland; elsewhere 'unnamed' is enough
if has('unnamedplus')
  set clipboard^=unnamed,unnamedplus
elseif has('clipboard')
  set clipboard^=unnamed
endif

" Git Bash's Vim has no clipboard support, but MSYS exposes the Windows
" clipboard as /dev/clipboard: copy unnamed yanks there, paste with
" :r /dev/clipboard
let s:devclip = !has('clipboard') && has('win32unix')
      \ && filewritable('/dev/clipboard')
function! s:SetClipboard(lines, linewise) abort
  if s:devclip
    call writefile(a:lines + (a:linewise ? [''] : []), '/dev/clipboard', 'b')
  else
    call setreg('+', a:lines, a:linewise ? 'l' : 'c')
  endif
endfunction
if s:devclip
  augroup vimrc_clipboard
    autocmd!
    autocmd TextYankPost * if v:event.regname ==# ''
          \ |   call s:SetClipboard(v:event.regcontents,
          \       v:event.regtype ==# 'V')
          \ | endif
  augroup END
endif

" Keep swap/backup/undo files out of the working directory.
" First 'runtimepath' entry is ~/.vim on Unix and ~/vimfiles on Windows.
let s:vimdir = expand(split(&runtimepath, ',')[0])
for s:d in ['undo', 'swap', 'backup']
  if !isdirectory(s:vimdir . '/' . s:d)
    call mkdir(s:vimdir . '/' . s:d, 'p', 0700)
  endif
endfor
let &undodir   = s:vimdir . '/undo//'
let &directory = s:vimdir . '/swap//'
let &backupdir = s:vimdir . '/backup//'
set undofile undolevels=10000
set viminfo='1000,<100,s10,h



" UI ---------------------------------------------------------------------------
set number relativenumber
set signcolumn=yes
set cursorline
set scrolloff=5 sidescrolloff=8
set splitbelow splitright
set nowrap
set linebreak breakindent
let &showbreak = '↪ '
set display=lastline,uhex
set laststatus=2
set showcmd
set noshowmode
set wildmenu wildoptions=pum,fuzzy
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*.o,*.pyc,.DS_Store
set wildignore+=*/.git/*,*/node_modules/*,*/target/*,*/dist/*
" (insert-mode completion is set up in vim/plugin/complete.vim)
set listchars=tab:➙\ ,trail:␣,extends:⟩,precedes:⟨,nbsp:·
let &fillchars = 'vert:│,fold: ,eob: '
" 'indent' folds are much cheaper to keep updated than 'syntax' folds
set foldmethod=indent foldlevelstart=99
if exists('+splitkeep')
  set splitkeep=screen         " opening/closing splits doesn't scroll
endif
if exists('+smoothscroll')
  set smoothscroll             " scroll wrapped lines by screen line
endif

" Diffs
" Set one by one: builds without the internal diff engine reject the first two
call s:TrySet('diffopt+=algorithm:histogram')
call s:TrySet('diffopt+=indent-heuristic')
call s:TrySet('diffopt+=linematch:60')

" Cursor shape: bar in insert, underline in replace, block otherwise
" (Windows console Vim and GUI Vim handle the cursor shape themselves)
if !has('gui_running') && !has('win32')
  let &t_SI = "\e[6 q"
  let &t_SR = "\e[4 q"
  let &t_EI = "\e[2 q"
endif

" True colour in truecolor terminals and in Windows Terminal / modern conhost.
" mintty (Git Bash) and Windows Terminal don't always set $COLORTERM.
if has('termguicolors') && ($COLORTERM =~# 'truecolor\|24bit' || has('vcon')
      \ || $TERM_PROGRAM ==# 'mintty' || !empty($WT_SESSION))
  set termguicolors
endif

if has('gui_running')
  set guioptions-=T guioptions-=m guioptions-=r guioptions-=L
  if has('win32')
    set guifont=Cascadia_Mono:h11,Consolas:h11
    set renderoptions=type:directx
  elseif has('mac')
    set guifont=Menlo:h13
  endif
endif
set background=dark
silent! colorscheme habamax

" Statusline
let s:modes = {'n': 'NORMAL', 'i': 'INSERT', 'R': 'REPLACE', 'v': 'VISUAL',
      \ 'V': 'V-LINE', "\<C-v>": 'V-BLOCK', 'c': 'COMMAND', 's': 'SELECT',
      \ 'S': 'S-LINE', "\<C-s>": 'S-BLOCK', 't': 'TERMINAL'}
function! StatusMode() abort
  return get(s:modes, mode(), mode())
endfunction
" Git branch from vim/plugin/git.vim, if it's loaded
function! StatusBranch() abort
  return exists('*GitBranch') ? GitBranch() : ''
endfunction

let &statusline = '%#PmenuSel# %{StatusMode()} %*%{StatusBranch()} %f%m%r%h%w'
      \ . '%=%y %{&fenc!=""?&fenc:&enc} [%{&ff}] %l:%c %p%% '



" Search -----------------------------------------------------------------------
set incsearch hlsearch
set ignorecase smartcase
" :grep uses ripgrep when available (vim/plugin/rg.vim)



" Indentation ------------------------------------------------------------------
" No 'smartindent': it fights filetype indent scripts (e.g. '#' to column 0)
set autoindent
set expandtab tabstop=4 shiftwidth=4 softtabstop=-1 shiftround
set formatoptions+=jn



" File finding -----------------------------------------------------------------
" :find searches recursively from cwd; <Tab> completes with fuzzy matching.
set path=.,**
" With ripgrep, completion comes from `rg --files` (vim/plugin/rg.vim)

" Yank highlight (stand-in for the hlyank package) -----------------------------
" Only used on 9.1 builds that predate the package.
if !s:has_hlyank
  function! s:HlYank() abort
    if v:event.operator !=# 'y' || v:event.regtype =~# "^\<C-v>"
      return
    endif
    let [l1, c1, l2, c2] = [line("'["), col("'["), line("']"), col("']")]
    let pat = v:event.regtype ==# 'V'
          \ ? '\%>' . (l1 - 1) . 'l\%<' . (l2 + 1) . 'l.*'
          \ : '\%' . l1 . 'l\%' . c1 . 'c\_.\{-}\%' . l2 . 'l\%' . c2 . 'c.'
    let id = matchadd('IncSearch', pat)
    let win = win_getid()
    call timer_start(150, {-> win_getid() == win ? matchdelete(id) : 0})
  endfunction
  augroup vimrc_hlyank
    autocmd!
    autocmd TextYankPost * silent! call s:HlYank()
  augroup END
endif



" netrw (built-in file explorer) -----------------------------------------------
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25
let g:netrw_list_hide = '\(^\|\s\s\)\zs\.\S\+,\.DS_Store'



" Keymaps ----------------------------------------------------------------------
" NB: never put a trailing "comment after a mapping — it becomes part of it.
" (mapleader is set at the top, before the first <leader> mapping)

" Move by display line when no count is given
nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'

" n/N always search in the same direction, and open folds
nnoremap <expr> n 'Nn'[v:searchforward] . 'zv'
nnoremap <expr> N 'nN'[v:searchforward] . 'zv'

" Y behaves like D and C
nnoremap Y y$

" Keep selection when indenting
xnoremap < <gv
xnoremap > >gv

" Move selected lines
xnoremap J :move '>+1<CR>gv=gv
xnoremap K :move '<-2<CR>gv=gv

" Undo break-points in insert mode
inoremap , ,<C-g>u
inoremap . .<C-g>u
inoremap ; ;<C-g>u

" Save / quit
nnoremap <silent> <C-s> :update<CR>
inoremap <silent> <C-s> <Esc>:update<CR>
xnoremap <silent> <C-s> <Esc>:update<CR>
nnoremap <leader>qq :qa<CR>

" Replace the word under the cursor / the selection in the whole file
nnoremap <leader>sr :%s/\<<C-r><C-w>\>//g<Left><Left>
xnoremap <leader>sr "zy:%s/\V<C-r>=escape(@z, '/\')<CR>//g<Left><Left>

" Clear search highlight / redraw
nnoremap <silent> <leader>ur :nohlsearch<Bar>diffupdate<CR><C-l>

" Windows
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <leader>ww <C-w>p
nnoremap <leader>wd <C-w>c
nnoremap <leader>w- <C-w>s
nnoremap <leader>w\| <C-w>v
nnoremap <silent> <C-w>K :resize +2<CR>
nnoremap <silent> <C-w>J :resize -2<CR>
nnoremap <silent> <C-w>H :vertical resize -2<CR>
nnoremap <silent> <C-w>L :vertical resize +2<CR>

" Buffers
nnoremap <silent> [b :bprevious<CR>
nnoremap <silent> ]b :bnext<CR>
nnoremap <leader>bd :bdelete<CR>
nnoremap <leader>fn :enew<CR>

" Explore / grep (fzf pickers are in vim/plugin/fzf.vim; :grep runs ripgrep
" when it's installed, see vim/plugin/rg.vim)
nnoremap <silent> <leader>e :Lexplore<CR>
nnoremap <silent> - :Explore<CR>
nnoremap <leader>sg :silent grep!<Space>

" Copy relative path (with line range in visual mode)
function! s:CopyPath(visual) abort
  let path = expand('%:~:.')
        \ . (a:visual ? ':' . line("'<") . ':' . line("'>") : '')
  call s:SetClipboard([path], 0)
  echo 'Copied: ' . path
endfunction
nnoremap <silent> <leader>fy :call <SID>CopyPath(0)<CR>
xnoremap <silent> <leader>fy :<C-u>call <SID>CopyPath(1)<CR>

" Quickfix / location list
nnoremap <silent> [q :cprevious<CR>
nnoremap <silent> ]q :cnext<CR>
nnoremap <silent> [l :lprevious<CR>
nnoremap <silent> ]l :lnext<CR>
nnoremap <silent> <leader>xq :copen<CR>
nnoremap <silent> <leader>xl :lopen<CR>

" Toggles
nnoremap <silent> <leader>us
      \ :let &l:spelllang = g:spelllangs<Bar>setlocal spell!<CR>
nnoremap <silent> <leader>uw :setlocal wrap!<CR>
nnoremap <silent> <leader>ul :setlocal list!<CR>
nnoremap <silent> <leader>uL :setlocal relativenumber!<CR>
nnoremap <silent> <leader>uv :setlocal cursorline!<CR>
nnoremap <silent> <leader>uS
      \ :let &l:colorcolumn = empty(&l:colorcolumn) ? '80' : ''<CR>

" Tabs
nnoremap <silent> <leader><Tab><Tab> :tabnew<CR>
nnoremap <silent> <leader><Tab>d :tabclose<CR>
nnoremap <silent> <leader><Tab>] :tabnext<CR>
nnoremap <silent> <leader><Tab>[ :tabprevious<CR>
nnoremap <silent> <leader><Tab>f :tabfirst<CR>
nnoremap <silent> <leader><Tab>l :tablast<CR>

" Terminal
nnoremap <silent> <leader>ft :botright terminal ++rows=12<CR>
tnoremap <Esc><Esc> <C-\><C-n>

" Write with sudo (not in Git Bash, which has no sudo)
if has('unix') && executable('sudo')
  cnoremap w!! w !sudo tee % >/dev/null
endif



" Autocommands -----------------------------------------------------------------
augroup vimrc
  autocmd!
  " Jump to last known cursor position
  autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line('$') && &ft !~# 'commit'
        \ |   exe 'normal! g`"zv'
        \ | endif
  " Reload files changed outside Vim
  autocmd FocusGained,BufEnter,CursorHold * silent! checktime
  " Equalize splits when the terminal is resized
  autocmd VimResized * wincmd =
  " Open quickfix after :grep / :make
  autocmd QuickFixCmdPost [^l]* cwindow
  autocmd QuickFixCmdPost l* lwindow
  " Close helper windows with q
  autocmd FileType help,qf,netrw nnoremap <buffer><silent> q :close<CR>
  " Prose
  autocmd FileType markdown,text,gitcommit setlocal wrap spell
        \ | let &l:spelllang = g:spelllangs
  " Two-space indent for these
  autocmd FileType javascript,typescript,typescriptreact,json,yaml
        \ setlocal shiftwidth=2 tabstop=2
  autocmd FileType html,css,svelte,nix,ocaml
        \ setlocal shiftwidth=2 tabstop=2
  " Real tabs where required
  autocmd FileType make,go setlocal noexpandtab
  " Strip trailing whitespace on save, but only in files that had none when
  " opened (so other people's files don't get noisy diffs), and never in
  " markdown or diffs, where it matters. .editorconfig can still force it.
  autocmd BufReadPost * let b:had_trailing_ws = search('\s\+$', 'nw') > 0
  autocmd BufWritePre *
        \ if &ft !~# '^\%(markdown\|diff\)$' && &modifiable
        \     && !get(b:, 'had_trailing_ws', 0)
        \ |   let s:v = winsaveview()
        \ |   keeppatterns %s/\s\+$//e
        \ |   call winrestview(s:v)
        \ | endif
augroup END

" Local overrides (not tracked)
for s:f in ['~/.vimrc.local', '~/_vimrc.local']
  if filereadable(expand(s:f))
    execute 'source' fnameescape(expand(s:f))
    break
  endif
endfor

