" Write with sudo (not in Git Bash, which has no sudo)
if has('unix') && executable('sudo')
  cnoremap w!! w !sudo tee % >/dev/null
endif



" Autocommands -----------------------------------------------------------------
augroup vimrc
  autocmd!
  " Jump to last known cursor position
  autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line('$') && &ft !~# 'commit'
        \ |   exe 'normal! g`"zv'
        \ | endif
  " Reload files changed outside Vim
  autocmd FocusGained,BufEnter,CursorHold * silent! checktime
  " Equalize splits when the terminal is resized
  autocmd VimResized * wincmd =
  " Open quickfix after :grep / :make
  autocmd QuickFixCmdPost [^l]* cwindow
  autocmd QuickFixCmdPost l* lwindow
  " Close helper windows with q
  autocmd FileType help,qf,netrw nnoremap <buffer><silent> q :close<CR>
  " Prose
  autocmd FileType markdown,text,gitcommit setlocal wrap spell
        \ | let &l:spelllang = g:spelllangs
  " Two-space indent for these
  autocmd FileType javascript,typescript,typescriptreact,json,yaml
        \ setlocal shiftwidth=2 tabstop=2
  autocmd FileType html,css,svelte,nix,ocaml
        \ setlocal shiftwidth=2 tabstop=2
  " Real tabs where required
  autocmd FileType make,go setlocal noexpandtab
  " Strip trailing whitespace on save (skip markdown, where it can matter)
  autocmd BufWritePre * if &ft !=# 'markdown' && &modifiable
        \ |   let s:v = winsaveview()
        \ |   keeppatterns %s/\s\+$//e
        \ |   call winrestview(s:v)
        \ | endif
augroup END

" Local overrides (not tracked)
for s:f in ['~/.vimrc.local', '~/_vimrc.local']
  if filereadable(expand(s:f))
    execute 'source' fnameescape(expand(s:f))
    break
  endif
endfor

